# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public URL used in QR codes and report links
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL (managed or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/carstatix?schema=public"

# Auth — use a long random string in production (openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# CORS — comma-separated origins (Flutter dev, web admin, etc.)
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Object storage (AWS S3 or S3-compatible: Cloudflare R2, MinIO)
# All of S3_REGION, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_PUBLIC_BASE_URL
# must be set to enable presigned photo/video uploads.
S3_REGION=us-east-1
S3_BUCKET=carstatix-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for objects (S3 website, CloudFront, or R2 public bucket URL). No trailing slash.
S3_PUBLIC_BASE_URL=https://carstatix-media.s3.us-east-1.amazonaws.com
# R2 example:
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
S3_FORCE_PATH_STYLE=false
S3_MAX_PHOTO_BYTES=15728640
S3_MAX_VIDEO_BYTES=52428800
S3_PRESIGN_EXPIRES_SECONDS=900
