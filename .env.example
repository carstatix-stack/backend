# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public URL used in QR codes and report links (no trailing slash).
# Local: http://localhost:3000
# Production (Railway): https://api.carstatix.com
# IMPORTANT: In production set this to https://api.carstatix.com (not localhost).
PUBLIC_BASE_URL=https://api.carstatix.com

# PostgreSQL — local, Railway Postgres, or any host
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Auth — use a long random string in production (openssl rand -base64 48)
JWT_SECRET=replace-with-at-least-32-characters-of-random-secret
# Prefer short-lived access tokens (e.g. 12h). Never commit a real secret.
JWT_EXPIRES_IN=12h

# CORS — comma-separated exact origins. Do NOT use * in production.
# Dev tip: NODE_ENV=development reflects any origin automatically.
CORS_ORIGINS=https://api.carstatix.com

# Cloudinary — required for inspection photo uploads.
# Dashboard: https://console.cloudinary.com → Account Details / API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=carstatix
CLOUDINARY_MAX_PHOTO_BYTES=15728640
CLOUDINARY_MAX_VIDEO_BYTES=52428800

# OpenAI — optional; required for AI DTC explanations
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
