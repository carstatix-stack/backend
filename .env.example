# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public URL used in QR codes and report links (no trailing slash).
# On Railway you can omit this — RAILWAY_PUBLIC_DOMAIN is used automatically.
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL — local, Railway Postgres, or any host
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Auth — use a long random string in production (openssl rand -base64 48)
JWT_SECRET=replace-with-at-least-32-characters-of-random-secret
JWT_EXPIRES_IN=7d

# CORS — comma-separated origins, or * in production if you need any origin
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Object storage is optional. Leave these unset to disable photo/video uploads.
# Cloudflare R2 example (S3-compatible):
# S3_REGION=auto
# S3_BUCKET=carstatix-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# S3_FORCE_PATH_STYLE=true
S3_MAX_PHOTO_BYTES=15728640
S3_MAX_VIDEO_BYTES=52428800
S3_PRESIGN_EXPIRES_SECONDS=900
